    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "pino": "^9.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  }
}